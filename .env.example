# MAISON ELORA ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and fill in your values
# DO NOT COMMIT .env.local TO GIT

SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public configuration (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY

# Server-only secret (NEVER EXPOSE IN FRONTEND CODE)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Admin bootstrap
ADMIN_BOOTSTRAP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Bangladesh Mobile Financial Services (MFS)
BKASH_PAYMENT_NUMBER=01700000000
NAGAD_PAYMENT_NUMBER=01800000000
ROCKET_PAYMENT_NUMBER=01900000000

# Optional Automated Payment Gateway
PAYMENT_GATEWAY_PUBLIC_KEY=
PAYMENT_GATEWAY_SECRET_KEY=

# Email / Notifications
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=orders@maisonelora.com

# Analytics & Tracking (Configurable from Admin or Env)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Business & Support
WHATSAPP_BUSINESS_NUMBER=+8801700000000
